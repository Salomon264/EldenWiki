# Скопируйте этот файл в .env и задайте свои значения:
#   cp .env.example .env
#
# Файл .env не попадает в git (см. .gitignore), поэтому секреты не утекут в репозиторий.

# Пароль root для MySQL (используется и контейнером db, и строкой подключения API).
MYSQL_ROOT_PASSWORD=AlikGumerov8g

# Ключ подписи JWT. Для HS256 нужен минимум 32 символа.
# Обязательно замените на длинную случайную строку в продакшене.
JWT_KEY=dev-only-insecure-signing-key-change-me-0123456789
